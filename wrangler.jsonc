{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "banumbers",
  "main": "./src/worker/index.ts",
  "compatibility_date": "2026-09-04",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    // The Vite plugin fills in `directory` at build time.
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [{ "name": "GAME_ROOM", "class_name": "GameRoom" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["GameRoom"] }],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
  // To host on your personal site, uncomment and edit one of these:
  // "routes": [{ "pattern": "banumbers.yourdomain.com", "custom_domain": true }]
}
